# Copy this file to .env.serverdb and fill in the real password (ask Mayank for it).
# .env.serverdb is gitignored — it will never be committed.
#
# Run with APP_ENV=serverdb to use this file instead of plain .env, pointing WorkFlow at
# the PRODUCTION database on the server instead of your local MySQL/SQLite. Requires the
# read-only-forwarding SSH tunnel (../connect-server-db.sh at the aqqum root) to be
# running first.
#
#   APP_ENV=serverdb uvicorn main:app --reload
#
# DATABASE_URL is the one that actually takes effect (it wins over DB_HOST/DB_PORT/etc. —
# see database.py's _build_database_url) — set it directly rather than the split vars.
# Everything else (SMTP, JWT secret, tokens, ...) is inherited from your normal .env, so
# this file only needs to carry the DB override.

DATABASE_URL=mysql+pymysql://root:REPLACE_ME@127.0.0.1:3307/multimedia_governance
