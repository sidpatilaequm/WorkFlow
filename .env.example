#Change this based on your database credentials. The above is for a local MySQL instance with username "root" and password "pswd".
DATABASE_URL=mysql+pymysql://root:pswd@localhost:3306/workflow_engine


# Set to 1 to enable debug mode and open CORS
DEBUG=0
FRONTEND_URL=http://localhost:3000

# SMTP — Replace with your own SMTP server for production use.
SMTP_HOST=smtp.io
SMTP_PORT=587
SMTP_USER=b6b170260
SMTP_PASSWORD=3e218c7d
SMTP_FROM_NAME=Workflow Engine

#Currently this is not used so can skip  the belwo credentials
# In production, make sure to set a strong secret key and keep it secure. You can generate one using Python's secrets module:

SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_ENV_VAR
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7


##The Below Are not required for basic functionality but can be filled in for additional features.
# Slack — fill in to enable Slack notifications
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Webhook HMAC secret for outgoing signed payloads
WEBHOOK_SECRET=

# Shared secret backend_java sends as the X-Service-Token header when
# calling POST /api/email-templates/trigger/{mail_key}. Must match
# workflow.email-templates.service-token in backend_java's application.properties.
JAVA_SERVICE_TOKEN=

# Company name shown in the email masthead/merge tag {{company_name}}
EMAIL_COMPANY_NAME=Ankit Aerospace Private Limited

# How often (minutes) the SLA escalation job runs
ESCALATION_CHECK_INTERVAL=15
